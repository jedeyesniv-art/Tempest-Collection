; Exports of the Tempest 4000 helper (xinput1_4.dll / xinput1_3.dll): the system XInput's names and ordinals.
EXPORTS
  XInputGetState              @2
  XInputSetState              @3
  XInputGetCapabilities       @4
  XInputEnable                @5
  XInputGetBatteryInformation @7
  XInputGetKeystroke          @8
