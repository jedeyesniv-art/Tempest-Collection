From 84a6a8bfcf017bef309c967b35b7a69a736fff25 Mon Sep 17 00:00:00 2001
From: John <sniv2001@hotmail.com>
Date: Sat, 14 Nov 2026 23:04:51 +0000
Subject: [PATCH 1/4] Windows libretro build: OpenSSL no-asm (no NASM needed)

---
 external/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 033f218..c39cd77 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -362,7 +362,7 @@ if(MSVC AND BUILD_LIBRETRO)
 			"@echo off\r\n"
 			"call \"${VITA3K_VCVARSALL_BAT_NATIVE}\" x64 >nul || exit /b 1\r\n"
 			"if \"%1\"==\"configure\" (\r\n"
-			"  \"${VITA3K_PERL_EXECUTABLE_NATIVE}\" Configure VC-WIN64A no-shared no-tests \"--prefix=${VITA3K_OPENSSL_INSTALL_DIR_NATIVE}\" \"--openssldir=${VITA3K_OPENSSL_INSTALL_DIR_NATIVE}\"\r\n"
+			"  \"${VITA3K_PERL_EXECUTABLE_NATIVE}\" Configure VC-WIN64A no-shared no-tests no-asm \"--prefix=${VITA3K_OPENSSL_INSTALL_DIR_NATIVE}\" \"--openssldir=${VITA3K_OPENSSL_INSTALL_DIR_NATIVE}\"\r\n"
 			") else (\r\n"
 			"  nmake %1\r\n"
 			")\r\n")
-- 
