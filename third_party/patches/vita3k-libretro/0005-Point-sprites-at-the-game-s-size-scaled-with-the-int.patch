--- a/vita3k/renderer/src/gl/draw.cpp
+++ b/vita3k/renderer/src/gl/draw.cpp
@@ -127,6 +127,7 @@ void draw(GLState &renderer, GLContext &context, const FeatureState &features, S
     vert_ublock.z_scale = context.record.z_scale;
     vert_ublock.screen_width = static_cast<float>(context.record.color_surface.width);
     vert_ublock.screen_height = static_cast<float>(context.record.color_surface.height);
+    vert_ublock.res_multiplier = renderer.res_multiplier;
 
     if (memcmp(&context.previous_vert_info, &vert_ublock, sizeof(shader::RenderVertUniformBlock)) != 0) {
         std::pair<std::uint8_t *, std::size_t> allocated_buffer = context.vertex_info_uniform_buffer.allocate(sizeof(shader::RenderVertUniformBlock));
@@ -220,6 +221,19 @@ void draw(GLState &renderer, GLContext &context, const FeatureState &features, S
     const GLenum mode = translate_primitive(type);
     const GLenum gl_type = format == SCE_GXM_INDEX_FORMAT_U16 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT;
 
+    // Point size. GL takes gl_PointSize from the shader only with GL_PROGRAM_POINT_SIZE on, and the GXM point/line
+    // width is only synced when it changes: without this, every point (TxK's particles) was 1 pixel at any resolution.
+    const bool is_point = type == SCE_GXM_PRIMITIVE_POINTS || (context.record.front_polygon_mode >= SCE_GXM_POLYGON_MODE_POINT_10UV && context.record.front_polygon_mode <= SCE_GXM_POLYGON_MODE_POINT_01UV) || context.record.front_polygon_mode == SCE_GXM_POLYGON_MODE_TRIANGLE_POINT;
+    if (is_point) {
+        const SceGxmProgram &vertex_program_gxp = *context.record.vertex_program.get(mem)->program.get(mem);
+        if (gxp::get_vertex_outputs(vertex_program_gxp) & SCE_GXM_VERTEX_PROGRAM_OUTPUT_PSIZE) {
+            glEnable(GL_PROGRAM_POINT_SIZE); // the shader scales its size by the resolution multiplier
+        } else {
+            glDisable(GL_PROGRAM_POINT_SIZE);
+            glPointSize(context.record.line_width * renderer.res_multiplier);
+        }
+    }
+
     if (instance_count == 1) {
         glDrawElements(mode, static_cast<GLsizei>(count), gl_type, reinterpret_cast<const void *>(index_gpu_ptr.second));
     } else {
