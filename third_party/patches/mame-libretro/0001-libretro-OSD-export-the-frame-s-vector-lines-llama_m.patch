From e1dc56a75c5503581598735cc1bc56df2ab1ed01 Mon Sep 17 00:00:00 2001
From: John <326213404+jedeyesniv-art@users.noreply.github.com>
Date: Tue, 17 Nov 2026 12:51:53 +0000
Subject: [PATCH] libretro OSD: export the frame's vector lines
 (llama_mame_lines) for t81.exe's own renderer

---
 src/osd/libretro/window.cpp | 37 +++++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/src/osd/libretro/window.cpp b/src/osd/libretro/window.cpp
index 77cb3c4f..d7739854 100644
--- a/src/osd/libretro/window.cpp
+++ b/src/osd/libretro/window.cpp
@@ -52,6 +52,42 @@ extern int norotate;
 static int svg_width;
 static int svg_height;
 
+
+//============================================================
+//  llama_mame_lines (Llamasoft collection, t81.exe): the frame's vector lines for a host that draws them itself.
+//  Each line = x0 y0 x1 y1 (0..1 of the render target), width (target pixels), colour as float a r g b
+//  (alpha = the beam intensity). Filled when the OSD fetches the primitives; read after retro_run.
+//============================================================
+
+namespace { std::vector<float> g_llama_lines; float g_llama_target[2]; }
+
+extern "C" __declspec(dllexport) const float *llama_mame_lines(int *count, float *target_w, float *target_h)
+{
+	if (count) *count = int(g_llama_lines.size() / 9);
+	if (target_w) *target_w = g_llama_target[0];
+	if (target_h) *target_h = g_llama_target[1];
+	return g_llama_lines.data();
+}
+
+static void llama_capture_lines(render_primitive_list &primlist, float w, float h)
+{
+	g_llama_lines.clear();
+	g_llama_target[0] = w;
+	g_llama_target[1] = h;
+	if (w <= 0 || h <= 0)
+		return;
+	primlist.acquire_lock();
+	for (const render_primitive &prim : primlist)
+	{
+		if (prim.type != render_primitive::LINE)
+			continue;
+		const float v[9] = { prim.bounds.x0 / w, prim.bounds.y0 / h, prim.bounds.x1 / w, prim.bounds.y1 / h, prim.width,
+				prim.color.a, prim.color.r, prim.color.g, prim.color.b };
+		g_llama_lines.insert(g_llama_lines.end(), v, v + 9);
+	}
+	primlist.release_lock();
+}
+
 //============================================================
 //  PARAMETERS
 //============================================================
@@ -512,6 +548,7 @@ void retro_window_info::update()
 			}
 
 			m_primlist = &primlist;
+			llama_capture_lines(primlist, float(fb_width), float(fb_height));
 
 			// if no bitmap, just fill
 			if (m_primlist == nullptr)
-- 
